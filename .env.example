# Base URL of the AI generation Worker (see workers/README.md).
# NEXT_PUBLIC_* vars are inlined at BUILD time — rebuild after changing this.
# Empty or unset = the AI Daily feature is silently disabled.
#
# PRODUCTION deploys: do NOT rely on this file (or .env.local!) — use
# `npm run deploy:web`, which forces the URL via process.env and verifies the
# built bundle before uploading (see README "Build guards").
NEXT_PUBLIC_API_URL=https://my-stash-api.siim-liimand.workers.dev
