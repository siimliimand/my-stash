// Wrangler configuration for the My Stash API Worker.
// Before deploying, replace the three REPLACE_WITH_* placeholders:
//   1. account_id      -> `npx wrangler whoami`
//   2. database_id     -> `npx wrangler d1 create my-stash-cards`
//   3. kv namespace id -> `npx wrangler kv namespace create KV`
// Secrets (never put these in this file):
//   npx wrangler secret put OPENROUTER_API_KEY
//   npx wrangler secret put ADMIN_SECRET
{
  "name": "my-stash-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "29f50b2c797dc5cd6ccd0cff405adb43",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-stash-cards",
      "database_id": "bae964bb-0d13-4aca-9b2f-4f88a3b7aa69"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "5b67cd2c595f4d31b3b1be5db76e9bef"
    }
  ],
  "triggers": {
    // "5 5 * * *"     — the daily generation batch (05:05 UTC).
    // "*/15 * * * *"  — poller that executes manual runs queued by
    //                   POST /api/generate. waitUntil promises on an HTTP
    //                   fetch event are killed ~30 s after the response on the
    //                   real runtime, while the pipeline needs ~77 s — a cron
    //                   invocation gets a 15-minute budget, so the manual run
    //                   is executed from here (run_requests table in D1).
    // The daily batch moved 0 5 -> 5 5 on 2026-09-28: every 0 5 fire for
    // three mornings ran STALE state (pre-16/day code + no secrets, i.e. the
    // worker as it existed when that trigger was first created on 09-25
    // 18:37), while */15 fires and HTTP requests ran the current version —
    // see README "Deviations" #21. A new expression is a new trigger row with
    // a fresh creation timestamp, which forces the scheduler to re-materialize
    // it. It also removes the 05:00:00 double-fire overlap with the poller.
    //
    // KNOWN PHANTOM (as of 2026-09-29): a stale trigger STILL fires daily at
    // ~05:00:17Z running the 09-25 version (no secrets, requested=50). It
    // generates 0 cards and only writes one misleading `failed` row to
    // generation_log ~5 min before the real 05:05 batch succeeds — harmless
    // to data. It is invisible to GET /schedules (only 5 5 + */15 exist) and
    // undeleteable with the wrangler OAuth token ("method not allowed for
    // this authentication scheme"). To kill it: create an API token with
    // Workers Scripts:Edit and DELETE /accounts/{acc}/workers/scripts/
    // my-stash-api/schedules — or remove it in dash.cloudflare.com under
    // this worker's Settings → Triggers if it is listed there.
    "crons": ["5 5 * * *", "*/15 * * * *"]
  },
  "vars": {
    // "~" prefix is OpenRouter's family alias — resolves to the latest Luna model.
    // (The plan's bare "openai/gpt-luna-latest" is NOT a valid id; verified 404.)
    "OPENROUTER_MODEL": "~openai/gpt-luna-latest",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "CORS_ORIGIN": "https://my-stash.pages.dev"
  }
}
